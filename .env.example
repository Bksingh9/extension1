# Copy to .env and fill in. NEVER commit .env.
# Start in dry_run; move to paper after testing; live requires ALLOW_LIVE=true AND operator action.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

ANTHROPIC_API_KEY=
NOTIFICATION_WEBHOOK=

# Optional: free-tier financial data APIs (public-apis registry).
# News + earnings (Finnhub, 60 req/min): https://finnhub.io
FINNHUB_API_KEY=
# Macro series (FRED, key optional for many series): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Backup bars (Alpha Vantage, 5 req/min): https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Earnings transcripts (Bigdata.com / RavenPack): https://bigdata.com  (SDK: pip install bigdata-client)
BIGDATA_USERNAME=
BIGDATA_PASSWORD=

# dry_run | paper | live
TRADING_MODE=dry_run

# Hard interlock for live mode. Must be true AND TRADING_MODE=live AND memory/go-live.md present.
ALLOW_LIVE=false

LOG_LEVEL=INFO
